APP_NAME=POS-KAHITA
APP_ENV=testing
APP_KEY=base64:edIKoz1WiS/Y9eJc5SPGAplP0GQ7+DZ+9HaskAyyEVU=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Test suite memakai MySQL, bukan sqlite.
#
# Sebagian migrasi proyek ini memakai DDL MySQL mentah
# (ALTER TABLE ... MODIFY ... ENUM), dan sqlite tidak bisa mem-parsingnya.
# Selain itu, fitur scope outlet produk bergantung pada type-strictness
# JSON_CONTAINS yang berbeda antara MySQL dan sqlite, sehingga pengujian
# di sqlite bisa hijau sementara MySQL merah.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_kahita_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=array

VITE_APP_NAME="${APP_NAME}"
